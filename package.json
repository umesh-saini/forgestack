{
  "name": "forgestack-workspace",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.4",
  "scripts": {
    "build": "pnpm --filter \"@forgestack/*\" run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "typecheck": "pnpm --filter \"@forgestack/*\" exec tsc --noEmit",
    "cli:dev": "node packages/cli/bin/create-forgestack-app.js",
    "desktop:web": "pnpm --filter @forgestack/desktop dev",
    "desktop:dev": "pnpm --filter @forgestack/desktop tauri dev",
    "desktop:build": "pnpm --filter @forgestack/desktop tauri build",
    "verify:templates": "pnpm build && scripts/verify-templates.sh",
    "test:matrix": "FORGESTACK_FULL_MATRIX=1 vitest run tests/e2e/combination-matrix.test.ts",
    "matrix:runtime": "pnpm build && node scripts/matrix/runtime.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.15.0",
    "turbo": "^2.11.12",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^3.0.5"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2"
  }
}
