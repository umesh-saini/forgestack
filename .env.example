# ForgeStack Environment Configuration Template

# Server & Runtime
NODE_ENV=development
PORT=3000

# Database Connections (example for PostgreSQL / SQLite)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/forgestack_dev?schema=public"
# DATABASE_URL="file:./dev.db"

# Authentication & Security
SESSION_SECRET="super-secret-key-at-least-32-chars-long"

# Automated CI/CD Publishing (set in GitHub Secrets)
# NPM_TOKEN="npm_xxxxxxxxxxxxxxxxxxxxxxxxxxxx"
